# clang-tidy configuration for packmule.
#
# The check list is curated rather than "*": this is a C11 codebase and most
# of clang-tidy's catalogue targets C++ or enforces house styles we do not
# share.  What is enabled is the set that finds real defects in code shaped
# like ours — hand-rolled parsers over untrusted input, manual memory
# management, and a lot of string handling.
#
# Everything enabled is an error.  A warning nobody has to fix is a warning
# everybody learns to scroll past.
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  cert-*,
  misc-*,
  performance-*,
  readability-misleading-indentation,
  readability-inconsistent-declaration-parameter-name,
  -bugprone-easily-swappable-parameters,
  -bugprone-assignment-in-if-condition,
  -bugprone-multi-level-implicit-pointer-conversion,
  -bugprone-unchecked-string-to-number-conversion,
  -bugprone-command-processor,
  -cert-err33-c,
  -cert-err34-c,
  -cert-env33-c,
  -bugprone-branch-clone,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-unix.Stream,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-unused-parameters,
  -misc-use-internal-linkage

# Why each of the above is off:
#
#   bugprone-easily-swappable-parameters
#       Fires on essentially every (const char *a, const char *b) comparator
#       here.  The parameter names carry the meaning.
#
#   bugprone-assignment-in-if-condition
#       Rejects the `while ((p = strstr(hay, needle)) != NULL)` idiom this
#       codebase uses consistently and which reads clearly in C.
#
#   bugprone-multi-level-implicit-pointer-conversion
#       Flags every `char **x = pm_malloc(...)`.  Implicit conversion from
#       void * is how allocation works in C; casting it is the C++ habit.
#
#   bugprone-branch-clone
#       Flags the PEP 440 qualifier table, where "preview", "pre" and "rc" are
#       distinct spellings that deliberately map to the same rank.  Collapsing
#       them would make the table harder to read, not safer.
#
#   cert-err33-c
#       Demands a check on every printf/fprintf.  The writes that matter —
#       manifest, checksums, install script, downloads — are checked
#       explicitly in write_text_file() and download_file(); progress and
#       diagnostic output is not worth the noise.
#
#   bugprone-unchecked-string-to-number-conversion / cert-err34-c
#       atoi() is used only where a non-numeric input should yield 0 — an
#       absent RPM epoch, a missing python minor.  That is the behaviour we
#       want, so there is no error to detect.
#
#   bugprone-command-processor / cert-env33-c
#       popen() and /bin/sh are deliberate: the post-bundle checks run the
#       real pip and the bundle's own install.sh, which is the entire point of
#       those checks.  Command strings are built from realpath() output that
#       is rejected if it contains a quote.
#
#   clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
#       Wants the C11 Annex K *_s functions, which glibc does not implement.
#
#   clang-analyzer-unix.Stream
#       Reports `while ((n = fread(...)) > 0) ...; if (ferror(fp))` as reading
#       past EOF.  fread returns 0 at EOF so the loop has already exited; this
#       is the standard idiom and the checker is known to misread it.
#
#   misc-include-cleaner
#       Wants every transitively-used symbol's header included directly;
#       fights the deliberate layering in include/.
#
#   misc-no-recursion
#       Flags the requirements-file include walker, whose depth is bounded by
#       MAX_INCLUDE_DEPTH.
#
#   misc-unused-parameters
#       Backend vtable functions must match their signature whether or not
#       they use every argument; these are marked (void)x at the call site.
#
#   misc-use-internal-linkage
#       Several functions are non-static solely so the test suite can reach
#       them; see include/registry_internal.h.

WarningsAsErrors: "*"

# Only diagnose our own sources, never system or dependency headers.
HeaderFilterRegex: "include/.*\\.h$"
